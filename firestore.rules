rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.dailyTarget is int && data.dailyTarget >= 1 && data.dailyTarget <= 10000000 &&
             data.setupCompleted is bool &&
             data.reminder1Hour is int && data.reminder1Hour >= 0 && data.reminder1Hour <= 23 &&
             data.reminder1Minute is int && data.reminder1Minute >= 0 && data.reminder1Minute <= 59 &&
             data.reminder2Hour is int && data.reminder2Hour >= 0 && data.reminder2Hour <= 23 &&
             data.reminder2Minute is int && data.reminder2Minute >= 0 && data.reminder2Minute <= 59 &&
             data.remindersEnabled is bool &&
             (!('themeMode' in data) || (data.themeMode is string && (data.themeMode == 'bw' || data.themeMode == 'red'))) &&
             // R4-C9 / profile heal: the app writes startedAtMillis on profile
             // create + update (Round 1 P1-1: it was missing from the allowlists,
             // so deploying this file denied every first sync). Optional so older
             // clients without the field keep working.
             (!('startedAtMillis' in data) || (data.startedAtMillis is int && data.startedAtMillis >= 0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDailyCount(data, userId, dateKey) {
      return data.userId is string && data.userId == userId &&
             data.dateKey is string && data.dateKey == dateKey &&
             data.count is int && data.count >= 0 && data.count <= 100000000 &&
             data.clientUpdatedAt is int && data.clientUpdatedAt >= 0 &&
             // R4-C9: every counted day carries its own dailyTarget (the app
             // stamps the profile target on create + update). Optional so days
             // written by older clients without the field keep working.
             (!('dailyTarget' in data) || (data.dailyTarget is int && data.dailyTarget >= 1 && data.dailyTarget <= 10000000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCustomCounter(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.targetCount is int && data.targetCount >= 1 && data.targetCount <= 100000000 &&
             data.currentCount is int && data.currentCount >= 0 && data.currentCount <= 100000000 &&
             data.clientUpdatedAt is int && data.clientUpdatedAt >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Server-computed read-only global aggregate doc
    match /stats/global {
      allow get: if isSignedIn();
      allow list, create, update, delete: if false;
    }

    // Server/admin-published read-only in-app announcements
    match /announcements/{announcementId} {
      allow get: if isSignedIn() && isValidId(announcementId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.token.email in ['1croresupport@gmail.com', 'mrmudasir1269@gmail.com'];
      allow delete: if isSignedIn() && request.auth.token.email in ['1croresupport@gmail.com', 'mrmudasir1269@gmail.com'];
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'dailyTarget', 'setupCompleted',
                         'reminder1Hour', 'reminder1Minute', 'reminder2Hour', 'reminder2Minute',
                         'remindersEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'dailyTarget', 'setupCompleted',
                         'reminder1Hour', 'reminder1Minute', 'reminder2Hour', 'reminder2Minute',
                         'remindersEnabled', 'themeMode', 'startedAtMillis', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'dailyTarget', 'setupCompleted',
                         'reminder1Hour', 'reminder1Minute', 'reminder2Hour', 'reminder2Minute',
                         'remindersEnabled', 'themeMode', 'startedAtMillis', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /daily_counts/{dateKey} {
        allow get: if isSignedIn() && isValidId(userId) && isValidDateKey(dateKey) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidDateKey(dateKey) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'count', 'clientUpdatedAt', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'count', 'clientUpdatedAt', 'dailyTarget', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidDailyCount(incoming(), userId, dateKey);

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidDateKey(dateKey) &&
                         request.auth.uid == userId &&
                         isValidDailyCount(incoming(), userId, dateKey) &&
                         incoming().userId == existing().userId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'count', 'clientUpdatedAt', 'dailyTarget', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidDateKey(dateKey) && request.auth.uid == userId;
      }

      match /custom_counters/{counterId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(counterId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(counterId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'targetCount', 'currentCount', 'clientUpdatedAt', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'targetCount', 'currentCount', 'clientUpdatedAt', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCustomCounter(incoming(), userId);

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(counterId) &&
                         request.auth.uid == userId &&
                         isValidCustomCounter(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'targetCount', 'currentCount', 'clientUpdatedAt', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(counterId) && request.auth.uid == userId;
      }
    }
  }
}
